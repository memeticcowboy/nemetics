# NEMA Meta-Harness Configuration
# Copy this file to meta-harness/.env and edit

# ── Model Backend ──────────────────────────────────────────
# Which adapter to use: "ollama" | "openai-compat" | "anthropic"
MODEL_ADAPTER=ollama

# Model name (adapter-specific)
MODEL_NAME=llama3.1:70b-instruct-q4_K_M

# Endpoint URL
MODEL_ENDPOINT=http://localhost:11434/v1

# API key (leave empty for local models)
MODEL_API_KEY=

# Max context length (tokens) — adjust for your model/hardware
MODEL_MAX_CONTEXT=32768

# Temperature — meta-harness needs non-zero for exploration
MODEL_TEMPERATURE=0.7

# ── Fallback Model (optional) ─────────────────────────────
# Used when primary model is unavailable or for verification
FALLBACK_ADAPTER=openai-compat
FALLBACK_MODEL=qwen2.5:32b
FALLBACK_ENDPOINT=http://localhost:11434/v1
FALLBACK_API_KEY=

# ── Anthropic (for hybrid routing) ────────────────────────
# Only needed if MODEL_ADAPTER=anthropic or for daemon synthesis
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Vault Configuration ───────────────────────────────────
# Path to the nemetics vault (this repo root)
VAULT_PATH=..

# Obsidian vault path (Windows sync target, if applicable)
OBSIDIAN_VAULT_PATH=/c/Users/dayze/OneDrive/Documents/Obsidian Vault/GitHub/nemetics

# Embedding model for vault indexing (runs locally via Ollama)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_ENDPOINT=http://localhost:11434

# ── Daemon Configuration ──────────────────────────────────
# Max parallel daemon spawns (set to 1 for single-GPU)
DAEMON_PARALLELISM=3

# Daemon timeout (ms) — how long each daemon gets per phase
DAEMON_TIMEOUT=120000

# ── Trace Storage ─────────────────────────────────────────
# Where to store execution traces
TRACE_DIR=./traces

# Max traces to retain (oldest pruned first)
MAX_TRACES=500

# ── Performance Tuning ────────────────────────────────────
# Apple Silicon: use Metal acceleration via Ollama
# NVIDIA: Ollama auto-detects CUDA
# CPU-only: reduce MODEL_MAX_CONTEXT and DAEMON_PARALLELISM

# Batch size for vault indexing (reduce if OOM)
INDEX_BATCH_SIZE=32
